<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:padding="8dp" android:background="@drawable/widget_bg">
        <LinearLayout android:id="@+id/a_movies" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:layout_margin="3dp" android:background="@drawable/widget_btn">
            <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_w_movie" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Movies" android:textColor="#FFFFFFFF" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/a_tv" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:layout_margin="3dp" android:background="@drawable/widget_btn">
            <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_w_tv" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="TV" android:textColor="#FFFFFFFF" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/a_search" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:layout_margin="3dp" android:background="@drawable/widget_btn">
            <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_w_search" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Search" android:textColor="#FFFFFFFF" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/a_downloads" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:layout_margin="3dp" android:background="@drawable/widget_btn">
            <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_w_download" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Downloads" android:textColor="#FFFFFFFF" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
</LinearLayout>
